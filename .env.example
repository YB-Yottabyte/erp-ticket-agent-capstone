# Template. Copy to .env and fill in ONE provider.
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# No key is needed at all for --provider mock, which is the default.

# Gemini has a free tier: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=

# Model names change often and old ones stop working for new accounts.
# Run `python list_models.py` to see what your key can actually call.
GEMINI_MODEL=gemini-3.7-flash

# Paid, needs prepaid credits. A ChatGPT subscription does NOT include API access.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Paid, needs prepaid credits.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5
